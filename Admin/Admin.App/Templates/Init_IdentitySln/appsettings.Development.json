{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Settings": {
    "AllowedOrigins": "*",
    "DbConnections": {
      "AuthConnection": "Server=localhost;Database=Auth;Trusted_Connection=True;TrustServerCertificate=True",
      "StockExConnection": "Server=localhost;Database=StockEx;Trusted_Connection=True;TrustServerCertificate=True"
    },
    "ApiBaseUrls": {
      "AuthApi": "https://localhost:6100",
      "StockExApi": "https://localhost:7100"
    },
    "JwtSettings": {
      "Issuer": "Bfs",
      "Audience": "StockEx",
      "AccessTokenExpireInMin": 60,
      "RefreshTokenExpireInDay": 2,
      "Secret": "a-string-secret-at-least-256-bits-long"
    }
  }
}
